@model IReadOnlyList<ClanDto>
@{
    ViewData["Title"] = "Manage Clans";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage Clans</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Clan</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Icon</th>
                    <th>Name</th>
                    <th>Shown as</th>
                    <th>Sort order</th>
                    <th>Status</th>
                    <th class="text-end">Members</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">No clans yet.</td></tr>
                }
                @foreach (var clan in Model)
                {
                    <tr>
                        <td>
                            @if (clan.IconUrl != null)
                            {
                                <img src="@clan.IconUrl" alt="" class="clan-admin-icon" />
                            }
                        </td>
                        <td>@clan.Name</td>
                        <td>
                            @clan.Statement
                            @if (clan.Article == null)
                            {
                                <small class="text-muted">(automatic)</small>
                            }
                        </td>
                        <td>@clan.SortOrder</td>
                        <td>
                            @if (clan.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">@clan.MemberCount</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@clan.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@clan.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
