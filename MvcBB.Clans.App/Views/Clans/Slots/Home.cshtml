@model IReadOnlyList<ClanDto>
<div class="card mb-4 clan-home-widget">
    <div class="card-header">
        <h5 class="card-title mb-0">Clans</h5>
    </div>
    <div class="card-body">
        <div class="list-group list-group-flush">
            @foreach (var clan in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="clan-badge">
                        @if (clan.IconUrl != null)
                        {
                            <img src="@clan.IconUrl" alt="" class="clan-icon" loading="lazy" />
                        }
                        <span>@clan.Name</span>
                    </span>
                    <span class="badge bg-secondary rounded-pill" title="Members">@clan.MemberCount</span>
                </div>
            }
        </div>
        <a asp-controller="Clans" asp-action="Index" class="d-block mt-2 small">All clans</a>
    </div>
</div>
