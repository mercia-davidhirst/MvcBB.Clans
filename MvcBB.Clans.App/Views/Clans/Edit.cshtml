@model ClanFormModel
@{
    ViewData["Title"] = "Edit Clan";
}

<h1>Edit Clan</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="col-md-6">
    <partial name="~/Views/Clans/_ClanForm.cshtml" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
</form>
